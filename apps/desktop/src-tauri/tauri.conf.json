{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GuideForge",
  "version": "0.1.0",
  "identifier": "com.guideforge.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @guideforge/web dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @guideforge/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GuideForge",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-first spatial work instructions",
    "longDescription": "GuideForge — author, review, publish, and execute spatial work instructions."
  }
}
