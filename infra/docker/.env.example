# GuideForge self-hosted secrets (copy to .env — never commit .env)
# The real key is supplied by the operator; never put it in this file in git.

# Current single-user semantic/vision transport (server-side only; never
# exposed to the browser). Put the real value only in the ignored .env file.
GUIDEFORGE_MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_VLM_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_REFERER=http://localhost:1420
OPENROUTER_APP_NAME=GuideForge

# Optional direct DeepSeek transport.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash

# Control plane secrets (change for production)
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-session
ROOM_TICKET_SECRET=change-me-tickets
