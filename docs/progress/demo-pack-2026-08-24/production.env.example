# PLACEHOLDER-ONLY production environment contract.
# Never commit real values.

NODE_ENV=production

# Public origin
GUIDEFORGE_PUBLIC_ORIGIN=https://guides.henning.rodeo
CORS_ORIGIN=https://guides.henning.rodeo

# Bind/internal routing — exact values depend on final compose design.
GUIDEFORGE_HOST=0.0.0.0

# Identifier only. DO NOT treat this as an authentication secret.
GUIDEFORGE_OWNER_ID=REPLACE_WITH_STABLE_UUID

# Existing API secrets
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
ROOM_TICKET_SECRET=REPLACE_WITH_RANDOM_SECRET
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET

# AI
GUIDEFORGE_AI_MODE=real
GUIDEFORGE_MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=REPLACE_IN_SECRET_STORE_ONLY
OPENROUTER_MODEL=REPLACE_WITH_SERVER_ALLOWLISTED_MODEL
OPENROUTER_REFERER=https://guides.henning.rodeo
OPENROUTER_APP_NAME=GuideForge

# Cloudflare AI Gateway
CLOUDFLARE_AI_GATEWAY_ACCOUNT_ID=REPLACE
CLOUDFLARE_AI_GATEWAY_ID=guideforge

# Anonymous AI guardrails
AI_PUBLIC_DEMO_ENABLED=true
AI_PUBLIC_DAILY_BUDGET_USD=2.00
AI_PUBLIC_MAX_COST_PER_REQUEST_USD=0.02
AI_PUBLIC_MAX_INPUT_TOKENS=3000
AI_PUBLIC_MAX_OUTPUT_TOKENS=800

# Turnstile (secret only at server)
TURNSTILE_SITE_KEY=REPLACE
TURNSTILE_SECRET_KEY=REPLACE_IN_SECRET_STORE_ONLY

# Companion if/when included
GUIDEFORGE_DATA_DIR=/data/guideforge
GUIDEFORGE_SECRET_KEY=REPLACE_IN_SECRET_STORE_ONLY
